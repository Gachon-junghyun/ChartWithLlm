# ── 대용량 데이터 (git에 올리지 않음) ──────────────────────────
ohlcv_cache/        # 종목별 pkl 캐시 (종목당 수백KB)
xy_pairs/           # X/Y 페어 JSONL (수백MB)
llm_output/         # LLM 추론 결과 (수백MB)

# ── 룰 사전은 올림 (결과물이므로) ─────────────────────────────
# rules/ 는 추적 O

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── 가상환경 ──────────────────────────────────────────────────
venv/
.venv/
env/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
